{
  "name": "antigravity-context-monitor",
  "displayName": "Antigravity Context Window Monitor",
  "description": "Real-time context window usage monitor for Antigravity ( Antigravity )",
  "version": "1.16.15",
  "publisher": "AGI-is-going-to-arrive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AGI-is-going-to-arrive/Antigravity-Context-Window-Monitor.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravity-context-monitor.showDetails",
        "title": "Show Context Window Details"
      },
      {
        "command": "antigravity-context-monitor.refresh",
        "title": "Refresh Context Window Monitor"
      },
      {
        "command": "antigravity-context-monitor.switchLanguage",
        "title": "Switch Display Language"
      },
      {
        "command": "antigravity-context-monitor.showActivityPanel",
        "title": "Show Model Activity"
      }
    ],
    "configuration": {
      "title": "Antigravity Context Monitor",
      "properties": {
        "antigravityContextMonitor.pollingInterval": {
          "type": "number",
          "default": 5,
          "description": "Polling interval in seconds"
        },
        "antigravityContextMonitor.statusBar.showContext": {
          "type": "boolean",
          "default": true,
          "description": "Show context usage (e.g. 45k/1M, 4.5%) in status bar"
        },
        "antigravityContextMonitor.statusBar.showQuota": {
          "type": "boolean",
          "default": true,
          "description": "Show current model quota indicator (e.g. 🟢85%) in status bar"
        },
        "antigravityContextMonitor.statusBar.showResetCountdown": {
          "type": "boolean",
          "default": true,
          "description": "Show quota reset countdown (e.g. ⏳4h32m) in status bar"
        },
        "antigravityContextMonitor.quotaNotificationThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 99,
          "description": "Show a warning notification when any model's remaining quota drops below this percentage (0 to disable)"
        },
        "antigravityContextMonitor.activity.maxRecentSteps": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 500,
          "description": "Maximum number of recent activity steps to keep in the timeline"
        },
        "antigravityContextMonitor.activity.maxArchives": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of activity archives to keep"
        },
        "antigravityContextMonitor.statusBar.showAiCredits": {
          "type": "boolean",
          "default": true,
          "description": "Show AI Credits balance (e.g. ⚡14701) in status bar and tooltip"
        },
        "antigravityContextMonitor.statusBar.tooltipDensity": {
          "type": "string",
          "enum": ["auto", "compact", "full"],
          "default": "auto",
          "description": "Status bar hover tooltip density. auto adapts to window.zoomLevel and quota row count; compact always trims; full shows all rows (may clip under high zoom)."
        },
        "antigravityContextMonitor.showModelInternalId": {
          "type": "boolean",
          "default": false,
          "description": "Show internal model ID suffix (e.g. M16, M26) next to model display names. Useful for diagnosing platform-level model changes."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "check:english": "node scripts/check-english-only.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
